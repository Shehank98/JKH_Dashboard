{
  "name": "ogilvy-orbit-chub",
  "version": "1.0.0",
  "description": "Ogilvy Orbit – Chub: competitive media spend for Sri Lankan advertisers. Upload an .xlsx or .csv spot log and compare your spend against competitors.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node --max-old-space-size=3072 server.js",
    "dev": "node server.js",
    "sample": "node scripts/generate-sample.js",
    "test": "node scripts/smoke-test.js",
    "test:auth": "node scripts/auth-test.js",
    "test:db": "node scripts/db-test.js",
    "test:readers": "node --max-old-space-size=4096 scripts/browser-readers-test.js",
    "check": "node scripts/check-drilldowns.js samples/sample_420000.csv",
    "verify": "node scripts/verify-drilldowns.js samples/sample_420000.csv"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "compression": "^1.7.4",
    "csv-parse": "^5.5.6",
    "exceljs": "^4.4.0",
    "express": "^4.21.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^2.5.2",
    "jszip": "^3.10.2",
    "pg": "^8.23.1",
    "pptxgenjs": "^4.0.1"
  }
}
